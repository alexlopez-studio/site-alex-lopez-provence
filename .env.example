# ============================================================
# Site Alex Lopez Provence — Variables d'environnement
# Copier ce fichier en .env.local et compléter les valeurs
# ============================================================

# URL de l'app assistant (ex: https://assistant.alexlopez-provence.fr)
NEXT_PUBLIC_ASSISTANT_APP_URL=

# URL Cal.com pour la prise de RDV
NEXT_PUBLIC_CALCOM_URL=https://cal.eu/alex-lopez-iad/30min

# URL des biens IAD (laisser vide = /biens placeholder)
NEXT_PUBLIC_IAD_LISTINGS_URL=

# URL du site (utilisé pour les canonicals SEO)
NEXT_PUBLIC_SITE_URL=https://alexlopez-provence.fr
