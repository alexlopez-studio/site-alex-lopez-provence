# Supabase (en pause — l'outil d'estimation doit fonctionner sans Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notion backup estimations (best-effort, ne bloque jamais l'estimation)
NOTION_API_KEY=
NOTION_ESTIMATIONS_PARENT_PAGE_ID=
# Optionnel : mode database si la base a une propriété titre nommée "Name"
NOTION_ESTIMATIONS_DATABASE_ID=

# DVF (Demandes de valeurs foncières) — estimation
# Source primaire : cerema (défaut) ou cquest.
# Cerema reste la source primaire recommandée actuellement ; cquest est une micro-API publique sans garantie de disponibilité.
DVF_PRIMARY_PROVIDER=cerema
DVF_ENABLE_FALLBACK=true
DVF_CEREMA_API_URL=https://apidf-preprod.cerema.fr/dvf_opendata/geomutations/
DVF_CQUEST_API_URL=https://api.cquest.org/dvf

# Attio CRM (best-effort, ne bloque jamais l'estimation)
# Phase API/Vercel-first : ATTIO_API_KEY suffit pour synchroniser People.
# Modes : people_only (défaut) ou people_and_lists (quand la liste pipeline est prête).
ATTIO_API_KEY=
ATTIO_SYNC_MODE=people_only
# Mode d'écriture des entrées de liste :
# - minimal : écrit seulement le statut pipeline (utile avec une liste Attio simple)
# - full : écrit tous les attributs CRM ci-dessous, quand ils existent dans Attio
ATTIO_LIST_ENTRY_MODE=minimal
# Pipeline vendeur : renseigner soit l'ID, soit le slug de la liste Attio parentée à People
# seulement quand ATTIO_SYNC_MODE=people_and_lists.
ATTIO_SELLER_LIST_ID=
ATTIO_SELLER_LIST_SLUG=
# Pipeline acheteur : renseigner soit l'ID, soit le slug de la liste Attio parentée à People
# seulement quand ATTIO_SYNC_MODE=people_and_lists.
ATTIO_BUYER_LIST_ID=
ATTIO_BUYER_LIST_SLUG=
# Optionnel : pipeline audit
ATTIO_AUDIT_LIST_ID=
ATTIO_AUDIT_LIST_SLUG=
# Optionnel : slug + valeur de l'attribut statut dans les listes Attio.
# La liste vendeur actuelle peut utiliser ATTIO_SELLER_STAGE_ATTRIBUTE=a_qualifier
# et ATTIO_SELLER_STAGE_VALUE=à qualifier.
ATTIO_SELLER_STAGE_ATTRIBUTE=stage
ATTIO_SELLER_STAGE_VALUE=Estimation demandée
ATTIO_BUYER_STAGE_ATTRIBUTE=stage
ATTIO_BUYER_STAGE_VALUE=Recherche reçue
ATTIO_AUDIT_STAGE_ATTRIBUTE=stage
ATTIO_AUDIT_STAGE_VALUE=Audit reçu

# Resend (magic link email)
RESEND_API_KEY=

# Assistant IA / integrations
# Secret serveur pour chiffrer les clés API IA, Google et Granola en base.
AI_CREDENTIALS_SECRET=
# OAuth Google Workspace (Gmail/Drive/Agenda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link JWT (legacy Phase A)
MAGIC_LINK_JWT_SECRET=

# Sanity (blog)
NEXT_PUBLIC_SANITY_PROJECT_ID=x2wprhnd
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Stream Estate (Marché immobilier)
STREAMESTATE_API_URL=https://api.stream.estate
STREAMESTATE_API_KEY=

# Cal.com
NEXT_PUBLIC_CALCOM_URL=https://cal.com/alex-lopez/consultation-gratuite

# Annonces IAD
NEXT_PUBLIC_IAD_LISTINGS_URL=

# Site URL (canonicals, OG, magic links)
NEXT_PUBLIC_SITE_URL=https://alexandrelopez.fr

# Analytics / conversion SEO-GEO
# Optionnel : si vide, aucun script GA4 n'est chargé et le site continue normalement.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optionnel : affiche les événements client dans la console navigateur.
NEXT_PUBLIC_ANALYTICS_DEBUG=false
# Optionnel : journalise les conversions serveur dans les logs Vercel.
ANALYTICS_SERVER_LOGS=true

# Admin
# DEPRECATED — l'auth /admin passe désormais par Supabase Auth (comptes + rôles).
# Cette variable n'est plus utilisée pour la connexion.
ADMIN_PASSWORD=

# Secret pour créer le 1er super admin via POST /api/admin/bootstrap.
# À définir temporairement, puis à retirer une fois le compte créé.
ADMIN_BOOTSTRAP_SECRET=
